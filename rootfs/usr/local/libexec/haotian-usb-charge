#!/usr/bin/env bash
# Arm Type-C OTG CC DRP toggle and apply safe Xiaomi MCA charging limits per charger_type.
set -euo pipefail

PSY="/sys/class/power_supply/xiaomi-mca-usb"
[[ -d "$PSY" ]] || exit 0

# 1. Enable Type-C CC DRP toggle so passive USB OTG devices (mice/hubs) are detected
if [[ -w "$PSY/cc_toggle" ]]; then
    echo 1 > "$PSY/cc_toggle" 2>/dev/null || true
fi

# 2. Apply safe per-charger-type input & charge current limits when online
online="$(<"$PSY/online" 2>/dev/null || echo 0)"
[[ "$online" == "1" ]] || exit 0

ctype="$(<"$PSY/charger_type" 2>/dev/null || echo Unknown)"
case "$ctype" in
    SDP)
        in_ua=500000; chg_ua=500000 ;;
    CDP)
        in_ua=900000; chg_ua=900000 ;;
    FLOAT|OCP)
        in_ua=1000000; chg_ua=1000000 ;;
    DCP|TYPEC|PD|PD_VERIFY|PPS|HVDCP*)
        in_ua=1500000; chg_ua=2000000 ;;
    *)
        exit 0 ;;
esac

echo "$in_ua" > "$PSY/input_current_limit" 2>/dev/null || true
echo "$chg_ua" > "$PSY/constant_charge_current" 2>/dev/null || true
