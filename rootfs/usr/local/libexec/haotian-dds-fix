#!/usr/bin/env python3
"""Configure Qualcomm QMI DSD Primary DDS (1) on cold boot before dmail starts.

Does NOT modify NAS mode_pref (preserves native 5G NR + LTE) and never modifies
Android NV/EFS settings.
"""
import socket
import struct
import subprocess
import sys
import time


def log(msg):
    ts = time.strftime("%H:%M:%S")
    print(f"[{ts}] haotian-dds-fix: {msg}", flush=True)


def find_port(svc, timeout=30.0):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        try:
            out = subprocess.check_output(["qrtr-lookup"], text=True)
            for line in out.splitlines()[1:]:
                parts = line.split()
                if len(parts) >= 5 and int(parts[0]) == svc and int(parts[3]) == 0:
                    return int(parts[4])
        except Exception:
            pass
        time.sleep(0.5)
    raise RuntimeError(f"QRTR service {svc} not found within {timeout}s")


def tlv(t, val):
    return struct.pack("<BH", t, len(val)) + val


def parse_tlvs(buf):
    res = {}
    i = 0
    while i + 3 <= len(buf):
        t, l = struct.unpack_from("<BH", buf, i)
        res[t] = buf[i + 3 : i + 3 + l]
        i += 3 + l
    return res


def qmi_req(sock, port, txn, msg_id, tlvs=b""):
    sock.sendto(struct.pack("<BHHH", 0, txn, msg_id, len(tlvs)) + tlvs, (0, port))
    while True:
        data, _ = sock.recvfrom(4096)
        if len(data) < 7:
            continue
        flags, rtxn, rmsg, rlen = struct.unpack_from("<BHHH", data, 0)
        if flags == 0x02 and rtxn == txn and rmsg == msg_id:
            return parse_tlvs(data[7 : 7 + rlen])


def main():
    dsd_port = find_port(42, timeout=30.0)
    log(f"QRTR DSD port ready: {dsd_port}")
    sd = socket.socket(42, socket.SOCK_DGRAM, 0)
    sd.settimeout(5.0)
    txn = 1

    # Ensure DSD data settings subscription = 0 (PRIMARY) and DDS = 1 (PRIMARY_SUBS)
    for attempt in range(1, 16):
        try:
            qmi_req(sd, dsd_port, txn, 0x0034, tlv(0x12, struct.pack("<I", 0)))
            txn += 1
            r = qmi_req(sd, dsd_port, txn, 0x004F)
            txn += 1
            cur = struct.unpack("<I", r[0x10])[0] if 0x10 in r and len(r[0x10]) == 4 else None
            log(f"attempt {attempt}: current DDS = {cur}")
            if cur == 1:
                return 0
            payload = tlv(0x01, struct.pack("<I", 1)) + tlv(0x10, struct.pack("<I", 0))
            r2 = qmi_req(sd, dsd_port, txn, 0x004E, payload)
            txn += 1
            rc = struct.unpack("<HH", r2[0x02]) if 0x02 in r2 and len(r2[0x02]) == 4 else None
            log(f"switch DDS -> PRIMARY(1): rc={rc}")
            if rc == (0, 0):
                time.sleep(0.5)
                r3 = qmi_req(sd, dsd_port, txn, 0x004F)
                txn += 1
                cur2 = struct.unpack("<I", r3[0x10])[0] if 0x10 in r3 and len(r3[0x10]) == 4 else None
                log(f"new DDS = {cur2}")
                if cur2 == 1:
                    return 0
        except Exception as e:
            log(f"attempt {attempt} error: {e}")
        time.sleep(1.0)

    log("warning: DDS did not confirm PRIMARY(1) within timeout")
    return 0


if __name__ == "__main__":
    sys.exit(main())
