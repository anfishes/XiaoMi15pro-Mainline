#!/usr/bin/env bash
# Populate /var/lib/haotian-tee/persist/data read-only from stock persist
# if not already present. NEVER writes to the real persist partition.
set -euo pipefail

BASE="/var/lib/haotian-tee"
PFM_DIR="$BASE/persist/data/pfm/licenses"
mkdir -p "$BASE/persist" "$BASE/data"
chmod 700 "$BASE"

if [[ ! -f "$PFM_DIR/store_0" ]]; then
    PERSIST_DEV="/dev/disk/by-partlabel/persist"
    for _ in $(seq 1 50); do
        [[ -b "$PERSIST_DEV" ]] && break
        sleep 0.2
    done
    if [[ -b "$PERSIST_DEV" ]]; then
        MNT="$(mktemp -d /run/haotian-persist-ro.XXXXXX)"
        trap 'umount "$MNT" 2>/dev/null || true; rmdir "$MNT" 2>/dev/null || true' EXIT
        mount -o ro,noload "$PERSIST_DEV" "$MNT"
        if [[ -d "$MNT/data" ]]; then
            cp -a "$MNT/data" "$BASE/persist/"
        fi
        umount "$MNT"
        rmdir "$MNT"
        trap - EXIT
    fi
fi

# Wait briefly for QTEE and UFS BSG nodes to settle on cold boot
for _ in $(seq 1 50); do
    [[ -c /dev/tee0 && -c /dev/bsg/ufs-bsg0 ]] && break
    sleep 0.2
done
