#!/usr/bin/env bash
# Ordered cold-boot bring-up for Xiaomi 15 Pro (SM8750) IPA + QWES + Modem + DDS
set -euo pipefail

LOG_FILE="/var/log/haotian-modem.log"
mkdir -p /var/log
exec > >(tee -a "$LOG_FILE") 2>&1

log() {
    printf '[%s] haotian-modem-init: %s\n' "$(date +%H:%M:%S)" "$*"
}

log "=== starting ordered modem bring-up ==="

# 1. Ensure IPA driver is loaded and bound to 3f40000.ipa before starting modem
#    (note: rmnet_ipa0 netdev is created after modem remoteproc comes up)
if [[ ! -e /sys/bus/platform/drivers/ipa/3f40000.ipa ]]; then
    log "loading ipa module"
    modprobe ipa 2>/dev/null || true
    for _ in $(seq 1 50); do
        [[ -e /sys/bus/platform/drivers/ipa/3f40000.ipa ]] && break
        sleep 0.2
    done
fi
if [[ ! -e /sys/bus/platform/drivers/ipa/3f40000.ipa ]]; then
    log "ERROR: 3f40000.ipa not bound"
    exit 1
fi
log "IPA bound: /sys/bus/platform/drivers/ipa/3f40000.ipa"

qrtr_has() {
    qrtr-lookup | awk -v svc="$1" '$1 == svc { found = 1 } END { exit !found }'
}

# 2. Wait for QRTR service 1059 (qwes-bridge)
for _ in $(seq 1 50); do
    qrtr_has 1059 && break
    sleep 0.2
done
if ! qrtr_has 1059; then
    log "ERROR: qwes-bridge (QRTR 1059) not serving"
    exit 1
fi
log "qwes-bridge (QRTR 1059) ready"

# 3. Start read-only rmtfs + tqftpserv and wait for QRTR service 14
if [[ -e /dev/qcom_rmtfs_mem1 ]]; then
    log "starting rmtfs.service and tqftpserv.service"
    systemctl start rmtfs.service tqftpserv.service
    for _ in $(seq 1 50); do
        qrtr_has 14 && break
        sleep 0.2
    done
    if ! qrtr_has 14; then
        log "ERROR: rmtfs (QRTR 14) not serving"
        exit 1
    fi
    log "rmtfs (QRTR 14) ready"
fi

# 4. Boot modem remoteproc (no crash dump or silent restart)
mss=
for p in /sys/class/remoteproc/remoteproc*; do
    [[ -e "$p/name" && "$(<"$p/name")" == "modem" ]] && mss="$p"
done
if [[ -z "$mss" ]]; then
    log "ERROR: no modem remoteproc"
    exit 1
fi
if [[ "$(<"$mss/state")" == "crashed" ]]; then
    log "modem state is crashed; stopping before restart"
    echo stop > "$mss/state"
fi
echo disabled > "$mss/recovery"
echo disabled > "$mss/coredump"

state="$(<"$mss/state")"
log "modem remoteproc ($mss) initial state=$state"
if [[ "$state" == "offline" ]]; then
    echo start > "$mss/state"
    log "modem remoteproc started (state=$(<"$mss/state"))"
elif [[ "$state" != "running" ]]; then
    log "ERROR: unexpected modem state: $state"
    exit 1
fi

# 5. Wait for rmnet_ipa0 to be created after modem running event
for _ in $(seq 1 50); do
    [[ -d /sys/class/net/rmnet_ipa0 ]] && break
    sleep 0.2
done
if [[ -d /sys/class/net/rmnet_ipa0 ]]; then
    log "rmnet_ipa0 ready"
else
    log "WARNING: rmnet_ipa0 did not appear within 10s"
fi

# 6. Wait for modem DSD service, ensure DDS = Primary (1), and wait for 5G/LTE PS attach
/usr/local/libexec/haotian-dds-fix
log "=== ordered modem bring-up complete ==="
