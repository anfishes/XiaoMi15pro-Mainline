--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8750-xiaomi-haotian.dts
@@ -0,0 +1,1232 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Xiaomi 15 Pro (haotian) — 主线 DT 骨架 v0.1
+ *
+ * 数据来源：
+ *   - 真机 DT 反编译：device/haotian-live.dts（44k 行）
+ *   - 社区 vendor DTS：repos/kernel_xiaomi_sm8750-devicetrees-lineage-22.2/qcom/haotian-*.dtsi
+ *   - 主线 SoC 描述：device/sm8750.dtsi（piano 树，v7.2.10）
+ *
+ * 状态：实验性板级 DTS；DTB 可编译，尚无成功的真机 Linux 启动记录。
+ * 带 TODO 的节点仍有未核实的硬件数据。
+ */
+
+/dts-v1/;
+
+#include "sm8750.dtsi"
+#include "pm8550.dtsi"
+#include "pmih0108.dtsi"
+#include "pmk8550.dtsi"
+#include "sm8750-pmics.dtsi"
+#include <dt-bindings/firmware/qcom,scm.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/linux-event-codes.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/leds/common.h>
+#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
+#include <dt-bindings/sound/qcom,q6dsp-lpass-ports.h>
+
+/ {
+	model = "Xiaomi 15 Pro (haotian)";
+	compatible = "xiaomi,haotian", "qcom,sm8750";
+	chassis-type = "handset";
+
+	/* ABL may replace root identity from the stock DTBO. */
+	xiaomi,mainline-model = "Xiaomi 15 Pro (haotian)";
+	xiaomi,mainline-compatible = "xiaomi,haotian", "qcom,sm8750";
+
+	aliases {
+		serial0 = &uart7;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+		/*
+		 * The real command line. The boot image carries an empty cmdline and
+		 * CONFIG_CMDLINE_FROM_BOOTLOADER means the kernel prefers whatever the
+		 * loader supplies, so the built-in CONFIG_CMDLINE was never used —
+		 * which is why console=tty0 and clk_ignore_unused had no effect.
+		 *
+		 * keep_bootcon: do not unregister the boot console when mdss takes
+		 *   over; without it the log vanishes exactly at the KMS handover.
+		 * clk_ignore_unused/pd_ignore_unused: keep the clocks and power domains
+		 *   the bootloader left running for scanout; the late_initcall cleanup
+		 *   otherwise turns them off about a second in.
+		 */
+		/*
+		 * 不再带 console=tty0。
+		 *
+		 * simpledrm 注册在 minor 0、crtc_index 0，而 msm 到 11 秒才 probe。
+		 * 只要 fbcon 绑在 tty0 上，drm_fb_helper_damage_work 就会去等
+		 * simpledrm 那个没有 enable_vblank 的 crtc，1 秒后超时：
+		 *   vblank wait timed out on crtc 0
+		 *   drm_crtc_wait_one_vblank+0x38c
+		 * 而 cmdline 里的 oops=panic 把它变成重启，屏幕就在两行黄线上重现。
+		 *
+		 * 没有 fbcon 后，内核日志走 console=ttyGS0（USB gadget）和 journal；
+		 * Denial 用 DRM 直写，不依赖 fbcon。
+		 */
+		bootargs = "console=ttyGS0,115200 drm.fbdev_emulation=0 clk_ignore_unused pd_ignore_unused loglevel=7 log_buf_len=4M rdinit=/init";
+	};
+
+	clocks {
+		xo_board: xo-board {
+			compatible = "fixed-clock";
+			clock-frequency = <76800000>;
+			#clock-cells = <0>;
+		};
+
+		sleep_clk: sleep-clk {
+			compatible = "fixed-clock";
+			clock-frequency = <32000>;
+			#clock-cells = <0>;
+		};
+
+		bi_tcxo_div2: bi-tcxo-div2-clk {
+			compatible = "fixed-factor-clock";
+			#clock-cells = <0>;
+			clocks = <&rpmhcc RPMH_CXO_CLK>;
+			clock-mult = <1>;
+			clock-div = <2>;
+		};
+
+		bi_tcxo_ao_div2: bi-tcxo-ao-div2-clk {
+			compatible = "fixed-factor-clock";
+			#clock-cells = <0>;
+			clocks = <&rpmhcc RPMH_CXO_CLK_A>;
+			clock-mult = <1>;
+			clock-div = <2>;
+		};
+	};
+
+	/*
+	 * reserved-memory：SoC 公共区域由 sm8750.dtsi 提供；
+	 * 这里只补 haotian 板级新增的几块（地址已与真机 DT 逐条核对）。
+	 */
+	reserved-memory {
+		display_dump_mem: display-dump@81cf4000 {
+			reg = <0x0 0x81cf4000 0x0 0x800>;
+			no-map;
+		};
+
+		rmtfs_mem: rmtfs@d7c00000 {
+			compatible = "qcom,rmtfs-mem";
+			reg = <0x0 0xd7c00000 0x0 0x400000>;
+			no-map;
+
+			qcom,client-id = <1>;
+			qcom,vmid = <QCOM_SCM_VMID_MSS_MSA>;
+		};
+
+		/* IPA DMA may only use IOVAs 0x20000000-0x3fffffff */
+		ipa_iova_resv: ipa-iova-reserved {
+			iommu-addresses = <&ipa 0x0 0x0 0x0 0x20000000>,
+					  <&ipa 0x0 0x40000000 0xffffffff 0xc0000000>;
+		};
+
+		ramoops_mem: ramoops@a3500000 {
+			compatible = "ramoops";
+			reg = <0x0 0xa3500000 0x0 0x400000>;
+			no-map;
+			record-size = <0x40000>;
+			console-size = <0x180000>;
+			pmsg-size = <0x180000>;
+		};
+
+		/*
+		 * ABL 只有在区域名恰好是 'splash_region' 时才会保持显示硬件供电，
+		 * 否则开机瞬间就会把面板断电。
+		 */
+		splash_mem: splash_region@fc800000 {
+			label = "cont_splash_region";
+			reg = <0x0 0xfc800000 0x0 0x2b00000>;
+			iommu-addresses = <&mdss 0 0xfc800000 0 0x2b00000>;
+			no-map;
+		};
+
+		/*
+		 * TODO(M4-b): 真机 DT 里 oem-vm 在 0xf8800000（0x3800000），
+		 * 而 sm8750.dtsi 已声明 oem_vm_mem@f7c00000。
+		 * 两者不一致，待确认哪个是实际生效区间后再决定是否覆盖。
+		 */
+	};
+
+	/* TODO(M4-a): UFS 供电先用固定电压占位，确认 PMIC LDO 后换回 */
+	ufs_vcc_vreg: regulator-ufs-vcc {
+		compatible = "regulator-fixed";
+		regulator-name = "ufs_vcc";
+		regulator-min-microvolt = <2500000>;
+		regulator-max-microvolt = <2500000>;
+		regulator-boot-on;
+	};
+
+	ufs_vccq_vreg: regulator-ufs-vccq {
+		compatible = "regulator-fixed";
+		regulator-name = "ufs_vccq";
+		regulator-min-microvolt = <1200000>;
+		regulator-max-microvolt = <1200000>;
+		regulator-boot-on;
+	};
+
+	/*
+	 * TODO(M3-a): 剩余的固件区域（adsp/cdsp/mpss/camera）已在
+	 * sm8750.dtsi 中声明，haotian 的尺寸仍需逐一核对。
+	 */
+
+	/* TODO(M3-c): 真机是 PM8550VE 的 LDO12（1.896 V），待确认 pmic-id 后换成 &vreg_l12b_1p9 */
+	touch_iovdd_vreg: regulator-touch-iovdd {
+		compatible = "regulator-fixed";
+		regulator-name = "touch_iovdd";
+		regulator-min-microvolt = <1896000>;
+		regulator-max-microvolt = <1896000>;
+		regulator-boot-on;
+	};
+
+	/* 触控 AVDD：原厂 haotian-sm8750.dtsi 由 TLMM GPIO114 使能 */
+	touch_avdd_vreg: regulator-touch-avdd {
+		compatible = "regulator-fixed";
+		regulator-name = "touch_avdd";
+		regulator-min-microvolt = <3000000>;
+		regulator-max-microvolt = <3000000>;
+		gpio = <&tlmm 114 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-boot-on;
+	};
+
+	/* 面板 VCI：真机是 PMIC L13B（3.0 V），piano.dts 里没有这一路 */
+	panel_vci_vreg: regulator-panel-vci {
+		compatible = "regulator-fixed";
+		regulator-name = "panel_vci";
+		regulator-min-microvolt = <3000000>;
+		regulator-max-microvolt = <3000000>;
+		regulator-boot-on;
+		/* TODO(M3-b): 换成 &vreg_l13b_3p0，需先确认 pmic-id */
+	};
+
+	/* 面板 I/O 供电（1.8 V），同样先固定占位 */
+	panel_vddio_vreg: regulator-panel-vddio {
+		compatible = "regulator-fixed";
+		regulator-name = "panel_vddio";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		regulator-boot-on;
+	};
+
+	/* DSI PHY 模拟供电 1.2 V */
+	panel_vdda_vreg: regulator-panel-vdda {
+		compatible = "regulator-fixed";
+		regulator-name = "panel_vdda";
+		regulator-min-microvolt = <1200000>;
+		regulator-max-microvolt = <1200000>;
+		regulator-boot-on;
+	};
+
+	/* DSI PHY 参考供电 0.88 V */
+	panel_vdds_vreg: regulator-panel-vdds {
+		compatible = "regulator-fixed";
+		regulator-name = "panel_vdds";
+		regulator-min-microvolt = <880000>;
+		regulator-max-microvolt = <880000>;
+		regulator-boot-on;
+	};
+
+	/*
+	 * eUSB2 PHY 的两路供电。真机 DT 里是 regulator-fixed，且 always-on；
+	 * 缺这两路时 phy@88e3000 probe 失败，dwc3 就拿不到 UDC。
+	 */
+	usb_vdd_0p88: regulator-usb-vdd-0p88 {
+		compatible = "regulator-fixed";
+		regulator-name = "usb_vdd_0p88";
+		regulator-min-microvolt = <880000>;
+		regulator-max-microvolt = <880000>;
+		regulator-always-on;
+	};
+
+	usb_vdda12_1p2: regulator-usb-vdda12-1p2 {
+		compatible = "regulator-fixed";
+		regulator-name = "usb_vdda12_1p2";
+		regulator-min-microvolt = <1200000>;
+		regulator-max-microvolt = <1200000>;
+		regulator-always-on;
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+
+		pinctrl-0 = <&volume_up_n>;
+		pinctrl-names = "default";
+
+		key-volume-up {
+			label = "Volume Up";
+			linux,code = <KEY_VOLUMEUP>;
+			gpios = <&pm8550_gpios 6 GPIO_ACTIVE_LOW>;
+			debounce-interval = <15>;
+			linux,can-disable;
+			wakeup-source;
+		};
+	};
+
+	/* Xiaomi MCA battery/charging & OTG protocol; USB roles via UCSI. */
+	pmic-glink {
+		compatible = "xiaomi,piano-pmic-glink",
+			     "qcom,sm8750-pmic-glink",
+			     "qcom,sm8550-pmic-glink",
+			     "qcom,pmic-glink";
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		connector@0 {
+			compatible = "usb-c-connector";
+			reg = <0>;
+			power-role = "dual";
+			data-role = "dual";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+
+					pmic_glink_hs_in: endpoint {
+						remote-endpoint = <&usb_dwc3_hs>;
+					};
+				};
+			};
+		};
+	};
+
+	sound {
+		compatible = "qcom,sm8750-sndcard", "qcom,sm8450-sndcard";
+		pinctrl-0 = <&i2s1_default>;
+		pinctrl-names = "default";
+
+		model = "Xiaomi-15-Pro";
+
+		speaker-dai-link {
+			link-name = "Secondary TDM Playback";
+
+			cpu {
+				sound-dai = <&q6apmbedai SECONDARY_TDM_RX_0>;
+				dai-tdm-slot-num = <2>;
+				dai-tdm-slot-width = <32>;
+				dai-tdm-slot-rx-mask = <1 1>;
+			};
+
+			codec {
+				sound-dai = <&cs35l43_b>, <&cs35l43_t>;
+				dai-tdm-slot-num = <2>;
+				dai-tdm-slot-width = <32>;
+				dai-tdm-slot-rx-mask = <1 1>;
+			};
+
+			platform {
+				sound-dai = <&q6apm>;
+			};
+		};
+	};
+
+	wcn7860_pmu: wcn7860-pmu {
+		compatible = "qcom,wcn7860-pmu";
+
+		pinctrl-0 = <&wlan_en>, <&bt_en_default>;
+		pinctrl-names = "default";
+
+		wlan-enable-gpios = <&tlmm 16 GPIO_ACTIVE_HIGH>;
+		bt-enable-gpios = <&pm8550ve_f_gpios 3 GPIO_ACTIVE_HIGH>;
+		swctrl-gpios = <&tlmm 18 GPIO_ACTIVE_HIGH>;
+
+		vddio-supply = <&vreg_l3f_1p8>;
+		vddio1p2-supply = <&vreg_l2f_1p2>;
+		vddaon-supply = <&vreg_s5f_0p88>;
+		vdddig-supply = <&vreg_s4d_0p88>;
+		vddrfa1p2-supply = <&vreg_s7i_1p31>;
+		vddrfa1p8-supply = <&vreg_s3g_1p86>;
+
+		clocks = <&rpmhcc RPMH_RF_CLK1>;
+
+		regulators {
+			vreg_pmu_aon_0p9: ldo0 {
+				regulator-name = "vreg_pmu_aon_0p9";
+			};
+
+			vreg_pmu_rfa_1p9: ldo1 {
+				regulator-name = "vreg_pmu_rfa_1p9";
+			};
+
+			vreg_pmu_rfa_1p3: ldo2 {
+				regulator-name = "vreg_pmu_rfa_1p3";
+			};
+
+			vreg_pmu_rfa_0p9: ldo3 {
+				regulator-name = "vreg_pmu_rfa_0p9";
+			};
+
+			vreg_pmu_wlmx_0p9: ldo4 {
+				regulator-name = "vreg_pmu_wlmx_0p9";
+			};
+
+			vreg_pmu_wlcx_0p9: ldo5 {
+				regulator-name = "vreg_pmu_wlcx_0p9";
+			};
+
+			vreg_pmu_btcx_0p9: ldo6 {
+				regulator-name = "vreg_pmu_btcx_0p9";
+			};
+
+			vreg_pmu_btcmx_0p9: ldo7 {
+				regulator-name = "vreg_pmu_btcmx_0p9";
+			};
+
+			vreg_pmu_pcie_1p2: ldo8 {
+				regulator-name = "vreg_pmu_pcie_1p2";
+			};
+
+			vreg_pmu_pcie_0p9: ldo9 {
+				regulator-name = "vreg_pmu_pcie_0p9";
+			};
+		};
+	};
+};
+
+/*
+ * RPMh 真实供电：PM8550 (pmic-id = "b") LDO12 = ldob12 (1.8 V)
+ * 实测 recovery 里 pm_humu_l12 users=1（仅触控），ABL 开机未打开，
+ * 必须通过 RPMh 真实开启，否则 S3910 无 I/O 电压、SPI 全读 0x00。
+ */
+&apps_rsc {
+	regulators-0 {
+		compatible = "qcom,pm8550-rpmh-regulators";
+		qcom,pmic-id = "b";
+
+		vreg_l5b_3p1: ldo5 {
+			regulator-name = "vreg_l5b_3p1";
+			regulator-min-microvolt = <3100000>;
+			regulator-max-microvolt = <3148000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+			regulator-allow-set-load;
+			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
+						   RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l12b_1p8: ldo12 {
+			regulator-name = "vreg_l12b_1p8";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+			regulator-allow-set-load;
+			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
+						   RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l15b_1p8: ldo15 {
+			regulator-name = "vreg_l15b_1p8";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+			regulator-allow-set-load;
+			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
+						   RPMH_REGULATOR_MODE_HPM>;
+		};
+	};
+
+	regulators-1 {
+		compatible = "qcom,pm8550ve-rpmh-regulators";
+		qcom,pmic-id = "d";
+
+		vreg_s4d_0p88: smps4 {
+			regulator-name = "vreg_s4d_0p88";
+			regulator-min-microvolt = <876000>;
+			regulator-max-microvolt = <1036000>;
+		};
+	};
+
+	regulators-2 {
+		compatible = "qcom,pm8550ve-rpmh-regulators";
+		qcom,pmic-id = "g";
+
+		vreg_s3g_1p86: smps3 {
+			regulator-name = "vreg_s3g_1p86";
+			regulator-min-microvolt = <1864000>;
+			regulator-max-microvolt = <2000000>;
+		};
+
+		vreg_l3g_1p2: ldo3 {
+			regulator-name = "vreg_l3g_1p2";
+			regulator-min-microvolt = <1200000>;
+			regulator-max-microvolt = <1256000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+			regulator-always-on;
+		};
+	};
+
+	regulators-3 {
+		compatible = "qcom,pm8550ve-rpmh-regulators";
+		qcom,pmic-id = "f";
+
+		vreg_s5f_0p88: smps5 {
+			regulator-name = "vreg_s5f_0p88";
+			regulator-min-microvolt = <876000>;
+			regulator-max-microvolt = <1000000>;
+		};
+
+		vreg_l1f_0p88: ldo1 {
+			regulator-name = "vreg_l1f_0p88";
+			regulator-min-microvolt = <880000>;
+			regulator-max-microvolt = <920000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+			regulator-always-on;
+		};
+
+		vreg_l2f_1p2: ldo2 {
+			regulator-name = "vreg_l2f_1p2";
+			regulator-min-microvolt = <1200000>;
+			regulator-max-microvolt = <1200000>;
+			regulator-always-on;
+		};
+
+		vreg_l3f_1p8: ldo3 {
+			regulator-name = "vreg_l3f_1p8";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-always-on;
+		};
+	};
+
+	regulators-4 {
+		compatible = "qcom,pm8550ve-rpmh-regulators";
+		qcom,pmic-id = "i";
+
+		vreg_s7i_1p31: smps7 {
+			regulator-name = "vreg_s7i_1p31";
+			regulator-min-microvolt = <1312000>;
+			regulator-max-microvolt = <1340000>;
+		};
+	};
+};
+
+&pcie0 {
+	pinctrl-0 = <&pcie0_default_state>;
+	pinctrl-names = "default";
+	status = "okay";
+};
+
+&pcie0_phy {
+	vdda-phy-supply = <&vreg_l1f_0p88>;
+	vdda-pll-supply = <&vreg_l3g_1p2>;
+	status = "okay";
+};
+
+&pcieport0 {
+	wake-gpios = <&tlmm 104 GPIO_ACTIVE_LOW>;
+	reset-gpios = <&tlmm 102 GPIO_ACTIVE_LOW>;
+
+	wifi@0 {
+		compatible = "pci17cb,110e";
+		reg = <0x10000 0x0 0x0 0x0 0x0>;
+
+		vddaon-supply = <&vreg_pmu_aon_0p9>;
+		vddwlcx-supply = <&vreg_pmu_wlcx_0p9>;
+		vddwlmx-supply = <&vreg_pmu_wlmx_0p9>;
