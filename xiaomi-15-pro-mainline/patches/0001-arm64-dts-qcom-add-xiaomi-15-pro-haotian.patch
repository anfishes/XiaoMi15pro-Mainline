+/* ABL Compatible Section —— 必须与真机 board-id 一致，否则 ABL 拒绝启动 */
+/ {
+	qcom,msm-id = <0x100026a 0x20000>, <0x000027f 0x10000>,
+		      <0x000026a 0x10000>, <0x000027f 0x20000>,
+		      <0x000026a 0x20000>, <0x100027f 0x10000>,
+		      <0x100026a 0x10000>, <0x100027f 0x20000>;
+	qcom,board-id = <0x40008 0>;
+};
+
+/*
+ * DRAM：SoC dtsi 里 memory@a0000000 的大小是 0，等 bootloader 填；
+ * 我们的启动链不会改写 DTB，所以必须在这里给出真实区间。
+ * 下面逐条取自真机 ABL 传给 Android 的 memory 节点（跳过 size=0 的项）。
+ */
+&{/memory@a0000000} {
+	reg = <0x00 0x81960000 0x00 0x000a0000>,
+	      <0x00 0x81a40000 0x00 0x001c0000>,
+	      <0x00 0x81cf4800 0x00 0x0000b800>,
+	      <0x00 0x82460000 0x00 0x00040000>,
+	      <0x00 0xe3720000 0x00 0x150e0000>,
+	      <0x00 0xfc400000 0x00 0x03400000>,
+	      <0x08 0x80000000 0x00 0x2f6fd000>,
+	      <0x08 0xb0000000 0x00 0x05500000>,
+	      <0x0a 0x00000000 0x02 0x00000000>,
+	      <0x08 0xc0000000 0x01 0x40000000>,
+	      <0x08 0xb5700000 0x00 0x01e00000>,
+	      <0x00 0x82800000 0x00 0x02200000>,
+	      <0x00 0x89d80000 0x00 0x01c80000>,
+	      <0x00 0xa3380000 0x00 0x14c80000>,
+	      <0x00 0xb8200000 0x00 0x1cc23000>,
+	      <0x00 0xd5100000 0x00 0x02f00000>;
+};
+
+/*
+ * 诊断用 framebuffer：指向 ABL 的 cont_splash 区域。
+ * 1440x3200, 32bpp, stride = 1440*4 = 5760。
+ *
+ * 这里显式声明 clocks / power-domains / required-opps / interconnects，
+ * 让 simpledrm 在「原生 KMS 还没接管」和「原生 KMS 接管完成」之间
+ * 都不会被 clk_disable_unused / sync_state 把扫出时钟收走。
+ * 形状抄 erhai 和 pad8pro；带宽按 haotian 的 1440x3200@120 重算，
+ * 不要用 piano 的 3200x2136 那组。
+ *
+ * o2_display_mode 时序：hfp/hsync/hbp = 16/16/16, vfp/vsync/vbp = 16/4/20
+ *   htotal = 1440 + 48 = 1488
+ *   vtotal = 3200 + 40 = 3240
+ *   avg  = 1440 * 3200 * 4 * 120 / 1000          = 2211840 kB/s
+ *   peak = 1440 * 3240 * 4 * 120 * 1.2 / 1000    = 2687385 kB/s
+ */
+/ {
+	framebuffer@fc800000 {
+		compatible = "simple-framebuffer";
+		reg = <0x0 0xfc800000 0x0 0x2b00000>;
+		width = <1440>;
+		height = <3200>;
+		stride = <5760>;
+		format = "a8r8g8b8";
+
+		clocks = <&gcc GCC_DISP_HF_AXI_CLK>,
+			 <&dispcc DISP_CC_MDSS_AHB_CLK>,
+			 <&dispcc DISP_CC_MDSS_MDP_CLK>,
+			 <&dispcc DISP_CC_MDSS_VSYNC_CLK>,
+			 <&dispcc DISP_CC_MDSS_BYTE0_CLK>,
+			 <&dispcc DISP_CC_MDSS_BYTE0_INTF_CLK>,
+			 <&dispcc DISP_CC_MDSS_PCLK0_CLK>,
+			 <&dispcc DISP_CC_MDSS_ESC0_CLK>,
+			 <&dispcc DISP_CC_MDSS_BYTE1_CLK>,
+			 <&dispcc DISP_CC_MDSS_BYTE1_INTF_CLK>,
+			 <&dispcc DISP_CC_MDSS_PCLK1_CLK>,
+			 <&dispcc DISP_CC_MDSS_ESC1_CLK>;
+		/*
+		 * MMCX 必须留在列表里，而且只有它有 required-opps。
+		 *
+		 * 试过改成 erhai 的形式（只留两个 GDSC + 两个 nom_l1）：GDSC 没有
+		 * OPP 表，MMCX 又被移走，vblank 中断随之停摆，fbcon 的
+		 * drm_crtc_wait_one_vblank 死等并 panic：
+		 *   pc : drm_crtc_wait_one_vblank
+		 *   drm_fb_helper_damage_work
+		 * 保持三个 power-domain，只在第一个（MMCX）上挂 opp。
+		 */
+		power-domains = <&rpmhpd RPMHPD_MMCX>,
+				<&dispcc MDSS_GDSC>,
+				<&dispcc MDSS_INT2_GDSC>;
+		required-opps = <&rpmhpd_opp_nom_l1>;
+		interconnects = <&mmss_noc MASTER_MDP QCOM_ICC_TAG_ALWAYS
+				 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>;
+		interconnect-names = "mdp0-mem";
+		operating-points-v2 = <&framebuffer_opp_table>;
+		/*
+		 * 保持 okay。
+		 *
+		 * 试过 disabled：没用。simpledrm 不是从 DT 节点创建的，而是
+		 * sysfb 解析全局 screen_info（UEFI/ABL 填充）后自己注册的
+		 * platform device——禁 DT 节点只是让 sysfb 换个来源，照样创建。
+		 *
+		 * 真正的崩溃点在内核：simpledrm 的 crtc 没有 enable_vblank，
+		 * fbcon 的 drm_fb_helper_damage_work 却等它的 vblank，1 秒超时
+		 * 后 WARN，被 oops=panic 变成重启。修在 simpledrm 里。
+		 */
+		status = "okay";
+
+		framebuffer_opp_table: opp-table {
+			compatible = "operating-points-v2";
+
+			opp-0 {
+				opp-peak-kBps = <2687385>;
+				opp-avg-kBps = <2211840>;
+			};
+		};
+	};
+};
+
+/*
+ * GPIO 保留范围：与原厂 msm 内核 sun.dtsi 的 qcom,gpios-reserved 一致
+ * (36 37 38 39 74 48 49 50 51)，也和 piano 板级 DTS 的
+ * gpio-reserved-ranges = <36 4>, <48 4>, <74 1> 对得上。
+ * 这些脚由固件/其它执行环境持有，Linux 不应把它们当作可用 GPIO 去操作。
+ */
+&tlmm {
+	gpio-reserved-ranges = <36 4>, <48 4>, <74 1>;
+
+	/*
+	 * TE（tearing effect）输入。
+	 *
+	 * 原厂 te-pin-select = <1> 且 te-using-te-pin，引脚是 TLMM GPIO86，
+	 * 功能 mdp_vsync。命令模式面板靠它告诉 DPU “可以下发下一帧写入”，
+	 * 没有这个信号，写入节奏对不上面板，画面也不会对。
+	 * 写法与同 SoC 的 sm8750-mtp.dts 一致。
+	 */
+	panel_te_default: panel-te-default-state {
+		pins = "gpio86";
+		function = "mdp_vsync";
+		bias-pull-down;
+		drive-strength = <2>;
+	};
+
+	ts_irq_default: ts-irq-default-state {
+		pins = "gpio162";
+		function = "gpio";
+		bias-disable;
+		input-enable;
+	};
+
+	ts_rst_default: ts-rst-default-state {
+		pins = "gpio161";
+		function = "gpio";
+		bias-disable;
+		drive-strength = <2>;
+	};
+
+	wlan_en: wlan-en-state {
+		pins = "gpio16";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-pull-down;
+	};
+
+	i2s1_default: i2s1-default-state {
+		sck-pins {
+			pins = "gpio121";
+			function = "i2s1_sck";
+			drive-strength = <8>;
+			bias-disable;
+		};
+
+		data0-pins {
+			pins = "gpio122";
+			function = "i2s1_data0";
+			drive-strength = <8>;
+			bias-disable;
+		};
+
+		ws-pins {
+			pins = "gpio123";
+			function = "i2s1_ws";
+			drive-strength = <8>;
+			bias-disable;
+		};
+
+		data1-pins {
+			pins = "gpio124";
+			function = "i2s1_data1";
+			drive-strength = <8>;
+			bias-disable;
+		};
+
+		rcv-switch-pins {
+			pins = "gpio67";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-pull-up;
+			output-high;
+		};
+	};
+};
+
+&q6apmbedai {
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	dai@28 {
