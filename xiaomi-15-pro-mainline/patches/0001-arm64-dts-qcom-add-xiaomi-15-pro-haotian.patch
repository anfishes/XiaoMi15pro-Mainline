+/*
+ * 显示：O2 系面板（1440x3200，DSC cmd mode，双 DSI）
+ *
+ * vendor DT 参数：h-front 16 / h-back 16 / h-pulse 16
+ *   v-back 20 / v-front 16 / v-pulse 4
+ *   DSC: slice 720x20, 2 slices/pkt, 10bpc, 8bpp
+ *   platform-reset-gpio = TLMM 0x62
+ *   亮度走 bl_ctrl_dcs（DSI 命令），没有 KTZ8866 背光 IC
+ *
+ * 注意：SM8750 的 DSI host 运行时会把 byte_src/pixel_src 重挂到自身
+ * clocks 里的 PLL，不要在 DSI 节点上写 assigned-clock-parents 指向
+ * 主 PHY，否则链路会挂死在初始化阶段。
+ */
+&mdss {
+	memory-region = <&splash_mem>;
+	/*
+	 * 两个 power domain 都必须开，不只是 MDSS_GDSC。
+	 *
+	 * 对照 linux-perpetua 的 sm8750-oneplus-erhai.dts（同 SoC、同为
+	 * bonded dual-DSI，Denial 已跑通）：少了 MDSS_INT2_GDSC 时控制通路
+	 * 会卡在复位里，DPU 照常产生 frame-done 和 page-flip 事件，但一帧
+	 * 都出不到面板上。我们的现象与之一致。
+	 *
+	 * 开 mdss 之前这里还是 disabled（让 simpledrm 直接写 ABL 显存）；
+	 * 原生 KMS 要求 dpcc 内建（CONFIG_SM_DISPCC_8750=y），否则
+	 * clocks = <&dispcc ...> 永远 -EPROBE_DEFER。
+	 */
+	power-domains = <&dispcc MDSS_GDSC>, <&dispcc MDSS_INT2_GDSC>;
+	status = "okay";
+};
+
+&mdss_mdp {
+	/*
+	 * 这里**不能**加 qcom,dpu-disable-multirect。
+	 *
+	 * erhai 禁用 multi-rect 是因为它 144Hz 要四个 mixer 各自独占 pipe；
+	 * 而我们的面板只有一个 plane，DPU 必须用 multi-rect 把这一 个源
+	 * 拆成左右两半喂两个 mixer（bonded dual-DSI 各扫一半）。
+	 *
+	 * 实测：加上该属性后 sspp 只分到一个 pipe（plane 43 → sspp 9，
+	 * multirect_idx 0），而 num_mixers 仍是 2，另一半画面无源，直接黑屏。
+	 */
+	status = "okay";
+};
+
+/*
+ * 单 DSI 命令模式面板。
+ *
+ * 原厂 dsi-panel-o2-42-02-0a-dsc-cmd.dtsi：
+ *   qcom,mdss-dsi-panel-type = "dsi_cmd_mode"
+ *   qcom,dsi-ctrl-num = <0>，qcom,dsi-phy-num = <0>   ← 只有 DSI0
+ *   qcom,display-topology = <2 2 1>                   ← 2 mixer + 2 DSC + 1 interface
+ *   qcom,mdss-dsi-te-pin-select = <1>，te-using-te-pin  ← TE 由 GPIO86 送入
+ *
+ * 之前按 piano/erhai 的样子写成 bonded dual-DSI video mode 是错的：
+ * 面板只在 DSI0 上听命令，并按 TE 节拍收写入。双链路拆半 + 视频流
+ * 会让解码器收到垃圾，表现为半屏绿条。
+ */
+&mdss_dsi0 {
+	vdda-supply = <&panel_vdda_vreg>;
+
+	status = "okay";
+
+	panel@0 {
+		compatible = "xiaomi,o2-42-02-0a";
+		reg = <0>;
+
+		vci-supply = <&panel_vci_vreg>;
+		vddio-supply = <&panel_vddio_vreg>;
+		vddi-supply = <&panel_vddio_vreg>;
+		reset-gpios = <&tlmm 0x62 GPIO_ACTIVE_LOW>;
+
+		/*
+		 * TE 输入：原厂 te-pin-select = 1 且 te-using-te-pin，
+		 * 引脚是 TLMM GPIO86，功能 mdp_vsync。
+		 */
+		pinctrl-0 = <&panel_te_default>;
+		pinctrl-names = "default";
+
+		width-mm = <69>;
+		height-mm = <156>;
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+
+				panel_in0: endpoint {
+					remote-endpoint = <&mdss_dsi0_out>;
+				};
+			};
+		};
+	};
+};
+
+&mdss_dsi0_out {
+	remote-endpoint = <&panel_in0>;
+	data-lanes = <0 1 2 3>;
+};
+
+/*
+ * DSI1 不使用：这块面板只在 DSI0 上（原厂 qcom,dsi-ctrl-num = <0>）。
+ * 之前为了 bonded dual-DSI 给 dsi1 重挂了 PHY PLL，那套现在一并去掉。
+ */
+&mdss_dsi1 {
