+/*
+ * 原厂参数来自 dsi-panel-o2-42-02-0a-dsc-cmd-common.dtsi：
+ *   qcom,mdss-dsi-panel-type = "dsi_cmd_mode"
+ *   qcom,dsi-ctrl-num = <0>，qcom,dsi-phy-num = <0>   ← 单 DSI
+ *   qcom,display-topology = <2 2 1>                   ← 2 mixer + 2 DSC + 1 interface
+ *   qcom,mdss-dsc-slice-width = <720>，slice-per-pkt = <2>
+ *   qcom,mdss-dsi-panel-clockrate = <1286000000>      ← 单链路 1.286 GHz
+ *   qcom,mdss-dsi-te-pin-select = <1>，te-using-te-pin  ← TE 由 gpio86 送入
+ *
+ * 之前按 piano/erhai 的样子当成 bonded dual-DSI video mode 写，是不对的：
+ * 面板只在 DSI0 上听命令，期望的是按 TE 节拍的命令模式写入。
+ * 双链路拆半 + 视频流 + 360 宽 slice，面板解出来就是绿条。
+ */
+static const struct panel_info o2_panel_info = {
+	.lanes = 4,
+	/*
+	 * 命令模式 + DSC：对照 linux-perpetua 的 rm692h5（10bpc + 8bpp DSC 命令模式）
+	 * 与 dsi_host.c 的 link_bpp 计算，压缩流按 24-bit RGB888 打包进 DSI 命令流，
+	 * 不是 RGB101010。
+	 */
+	.format = MIPI_DSI_FMT_RGB888,
+	/*
+	 * 命令模式：不要 MIPI_DSI_MODE_VIDEO。
+	 * 保留 CLOCK_NON_CONTINUOUS 与 DSC_ALL_SLICES_IN_PKT；
+	 * 不加 NO_EOT_PACKET——原厂 init 序列末尾自己带 EOT。
+	 * LPM 由 prepare/enable 分阶段切换，见 o2_prepare/enable。
+	 */
+	.mode_flags = MIPI_DSI_CLOCK_NON_CONTINUOUS |
+		      MIPI_DSI_MODE_DSC_ALL_SLICES_IN_PKT,
+	.modes = &o2_display_mode,
+	.num_modes = 1,
+	.supplies = o2_supplies,
+	.num_supplies = ARRAY_SIZE(o2_supplies),
+	.display_off_delay_ms = 20,
+	.sleep_in_delay_ms = 100,
+	.dsc_cfg = &o2_dsc_cfg,
+	.init_sequence = o2_init_sequence,
+	.is_dual_dsi = false,
+};
+
+static const struct of_device_id o2_of_match[] = {
+	{ .compatible = "xiaomi,o2-42-02-0a", .data = &o2_panel_info },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, o2_of_match);
+
+static struct mipi_dsi_driver o2_driver = {
+	.probe = o2_probe,
+	.driver = {
+		.name = "panel-xiaomi-o2",
+		.of_match_table = o2_of_match,
+	},
+};
+module_mipi_dsi_driver(o2_driver);
