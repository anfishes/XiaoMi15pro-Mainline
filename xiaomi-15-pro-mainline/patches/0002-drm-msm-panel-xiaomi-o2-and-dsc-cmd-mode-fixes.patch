+struct o2 {
+	struct drm_panel panel;
+	struct drm_connector *connector;
+	struct mipi_dsi_device *dsi[2];
+	const struct panel_info *panel_info;
+	struct drm_dsc_config dsc;
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data *supplies;
+};
+
+struct panel_info {
+	unsigned int lanes;
+	enum mipi_dsi_pixel_format format;
+	unsigned long mode_flags;
+
+	/* The first mode is the preferred one */
+	const struct drm_display_mode *modes;
+	unsigned int num_modes;
+
+	/* Enabled in this order and disabled in reverse order */
+	const struct regulator_bulk_data *supplies;
+	unsigned int num_supplies;
+	const unsigned int *supply_off_delay_ms;
+	unsigned int display_off_delay_ms;
+	unsigned int sleep_in_delay_ms;
+
+	const struct drm_dsc_config *dsc_cfg;
+
+	int (*init_sequence)(struct o2 *ctx,
+			     const struct drm_display_mode *mode);
+
+	void (*reset)(struct o2 *ctx);
+
+	bool is_dual_dsi;
+};
+
+static const struct regulator_bulk_data o2_supplies[] = {
+	{ .supply = "vci" },   /* 3.0v, PMIC L13B */
+	{ .supply = "vddio" }, /* 1.8v */
+	{ .supply = "vddi" },  /* 1.8v */
+};
+
+static inline struct o2 *to_o2(struct drm_panel *panel)
+{
+	return container_of(panel, struct o2, panel);
+}
+
+static inline struct mipi_dsi_device *to_primary_dsi(struct o2 *ctx)
+{
+	/* Sync on DSI1 for dual dsi */
+	return ctx->panel_info->is_dual_dsi ? ctx->dsi[1] : ctx->dsi[0];
+}
+
+static const struct drm_display_mode *o2_current_mode(struct o2 *ctx)
+{
+	const struct panel_info *panel_info = ctx->panel_info;
+	const struct drm_display_mode *mode;
+	unsigned int i;
+
+	if (!ctx->connector || !ctx->connector->state ||
+	    !ctx->connector->state->crtc)
+		return &panel_info->modes[0];
+
+	mode = &ctx->connector->state->crtc->state->adjusted_mode;
+	for (i = 0; i < panel_info->num_modes; i++)
+		if (drm_mode_match(mode, &panel_info->modes[i],
+				   DRM_MODE_MATCH_TIMINGS | DRM_MODE_MATCH_CLOCK))
+			return &panel_info->modes[i];
+
+	return &panel_info->modes[0];
+}
+
+static int o2_power_on(struct o2 *ctx)
+{
+	const struct panel_info *panel_info = ctx->panel_info;
+	int i, ret;
+
+	for (i = 0; i < panel_info->num_supplies; i++) {
+		ret = regulator_enable(ctx->supplies[i].consumer);
+		if (ret) {
+			while (--i >= 0)
+				regulator_disable(ctx->supplies[i].consumer);
+			return ret;
+		}
+		if (panel_info->num_supplies > 1)
+			usleep_range(2000, 3000);
+	}
+
+	return 0;
+}
+
+static void o2_power_off(struct o2 *ctx)
+{
+	const struct panel_info *info = ctx->panel_info;
+	int i;
+
+	for (i = info->num_supplies - 1; i >= 0; i--) {
+		regulator_disable(ctx->supplies[i].consumer);
+		if (info->supply_off_delay_ms)
+			usleep_range(info->supply_off_delay_ms[i] * 1000,
+				     info->supply_off_delay_ms[i] * 1000 + 100);
+	}
+}
+
+static void o2_reset(struct o2 *ctx)
+{
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(10000, 10100);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(5000, 5100);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(15000, 15100);
+}
+
+static int o2_prepare(struct drm_panel *panel)
+{
+	struct o2 *ctx = to_o2(panel);
+	int ret;
+
+	dev_info(panel->dev, "o2_prepare: powering on\n");
+
+	ret = o2_power_on(ctx);
+	if (ret < 0) {
+		dev_err(panel->dev, "o2_prepare: power_on failed %d\n", ret);
+		return ret;
+	}
+
+	if (ctx->panel_info->reset)
+		ctx->panel_info->reset(ctx);
+	else
+		o2_reset(ctx);
+
+	dev_info(panel->dev, "o2_prepare: sending init sequence\n");
+
+	ret = ctx->panel_info->init_sequence(ctx, o2_current_mode(ctx));
+	if (ret < 0) {
+		dev_err(panel->dev, "o2_prepare: init sequence failed %d\n", ret);
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		o2_power_off(ctx);
+		return ret;
+	}
+
+	/*
+	 * Everything above can succeed while the panel still shows nothing: the
+	 * PPS and the display-on command are separate writes and a link that is
+	 * not draining shows no error at this point. Record that the sequence
+	 * completed so a blank panel can be told apart from a skipped prepare.
+	 */
+	dev_info(panel->dev, "o2_prepare: done, dsc enabled\n");
+
+	return 0;
+}
+
+/*
+ * 面板从命令模式切回高速模式开始扫描。
+ *
+ * init 序列在 LP 模式下发（原厂 on-command-state = dsi_lp_mode），
+ * 发完必须清掉 MODE_LPM，否则像素数据继续走低功耗时序。
+ * nt37801（同 SoC、同为单 DSI 命令模式 + DSC）就是这么分的。
+ */
+static int o2_enable(struct drm_panel *panel)
+{
+	struct o2 *ctx = to_o2(panel);
+	struct mipi_dsi_device *dsi = to_primary_dsi(ctx);
+
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	return 0;
+}
+
+static int o2_disable(struct drm_panel *panel)
+{
+	struct o2 *ctx = to_o2(panel);
+	struct mipi_dsi_device *dsi = to_primary_dsi(ctx);
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	return 0;
+}
+
+/*
+ * 亮度走 DCS 0x51 的大端 16 位值。
+ *
+ * 这块 OLED 没有背光 IC（原厂 bl-pmic-control-type = "bl_ctrl_dcs"），
+ * 亮度就是面板自己的寄存器。原厂标了 bl-inverted-dbv，指的是 16 位值
+ * 按大端发、由面板自行解释，上游对应 mipi_dsi_dcs_set_display_brightness_large()。
+ * bl-dsc-cmd-state = dsi_hs_mode，所以发亮度时必须先离开 LPM。
+ */
+static int o2_bl_update_status(struct backlight_device *bl)
+{
+	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	u16 brightness = backlight_get_brightness(bl);
+	int ret;
+
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	ret = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	return ret;
+}
+
+static const struct backlight_ops o2_bl_ops = {
+	.update_status = o2_bl_update_status,
+};
+
+/*
+ * 两个原厂上限值（haotian-sde-display.dtsi 的 4095、panel 文件覆盖的 16383）。
+ * 这里用 bl-max-level = <0xfff> = 4095，与 DCS 5 字节亮度范围一致。
+ */
+static struct backlight_device *o2_create_backlight(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	const struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.brightness = 2048,
+		.max_brightness = 4095,
+	};
+
+	return devm_backlight_device_register(dev, dev_name(dev), dev, dsi,
+					      &o2_bl_ops, &props);
+}
+
+static int o2_off(struct o2 *ctx)
+{
+	struct mipi_dsi_device *dsi = to_primary_dsi(ctx);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = dsi };
+
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_usleep_range(&dsi_ctx,
+			     ctx->panel_info->display_off_delay_ms * 1000,
+			     ctx->panel_info->display_off_delay_ms * 1000 + 100);
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, ctx->panel_info->sleep_in_delay_ms);
+
+	return dsi_ctx.accum_err;
+}
+
+static int o2_unprepare(struct drm_panel *panel)
+{
+	struct o2 *ctx = to_o2(panel);
+	struct device *dev = &ctx->dsi[0]->dev;
+	int ret;
+
+	ret = o2_off(ctx);
+	if (ret < 0)
+		dev_err(dev, "Failed to un-initialize panel: %d\n", ret);
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	o2_power_off(ctx);
+
+	return 0;
+}
+
+static int o2_get_modes(struct drm_panel *panel,
+			     struct drm_connector *connector)
+{
+	struct o2 *ctx = to_o2(panel);
+	const struct panel_info *panel_info = ctx->panel_info;
+	unsigned int i;
+
+	for (i = 0; i < panel_info->num_modes; i++) {
+		struct drm_display_mode *mode;
+
+		mode = drm_mode_duplicate(connector->dev, &panel_info->modes[i]);
+		if (!mode)
+			return -ENOMEM;
+
+		mode->type = DRM_MODE_TYPE_DRIVER;
+		if (i == 0)
+			mode->type |= DRM_MODE_TYPE_PREFERRED;
+
+		drm_mode_set_name(mode);
+		drm_mode_probed_add(connector, mode);
+	}
+
+	connector->display_info.width_mm = panel_info->modes[0].width_mm;
+	connector->display_info.height_mm = panel_info->modes[0].height_mm;
+	ctx->connector = connector;
+
+	return panel_info->num_modes;
+}
