#!/usr/bin/env python3
"""Wrapper for /usr/lib/hexagonrpcd/stock-sensors on SunUEFI (no slot_suffix)."""
import importlib.machinery
import importlib.util

spec = importlib.util.spec_from_loader(
    "stock_sensors",
    importlib.machinery.SourceFileLoader("stock_sensors", "/usr/lib/hexagonrpcd/stock-sensors"),
)
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)

orig_booted_slot = mod.booted_slot
mod.booted_slot = lambda: orig_booted_slot() or "_a"
mod.main()
